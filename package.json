{
  "name": "cv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node build.js --watch --serve",
    "build": "node build.js",
    "lint": "prettier --check . && eslint . && stylelint '**/*.css'",
    "format": "prettier --write . && eslint --fix . && stylelint --fix '**/*.css'",
    "watch": "node build.js --watch",
    "test": "node validate.js",
    "spellcheck": "cspell",
    "prepare": "husky"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "normalize.css": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chokidar": "^6.0.0",
    "cspell": "^10.4.1",
    "cssnano": "^9.9.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.1.1",
    "globals": "^17.14.0",
    "handlebars": "^4.7.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.4.31",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.2",
    "prettier": "^3.0.3",
    "puppeteer": "^25.16.0",
    "resume-schema": "^1.0.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.js": "eslint --fix",
    "*.css": "stylelint --fix",
    "*.{md,hbs}": "cspell --no-must-find-files --no-progress",
    "src/resume.json": "cspell --no-must-find-files --no-summary --no-progress"
  }
}
